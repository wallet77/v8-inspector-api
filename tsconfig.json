{
  "compilerOptions": {
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./types"
  },
  "include": [
    "index.js",
    "src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "types"
  ]
}
